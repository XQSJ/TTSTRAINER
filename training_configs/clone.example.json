{
  "_comment": "上传参考录音并训练克隆音色 / Train a cloned voice from an uploaded recording",
  "preset": "quality",
  "experiment": {
    "name": "model_clone",
    "languages": ["zh", "en", "ja", "ko", "fr", "es", "pt"],
    "device": "cuda:0"
  },
  "dataset": {
    "sentences_per_language": 2000,
    "text": {
      "provider": "builtin"
    },
    "voice": {
      "id": "my_voice",
      "mode": "clone",
      "speaker": "my_voice",
      "reference_audio": "datasets/references/my_voice.wav",
      "reference_text": "这里必须填写与参考录音逐字一致的文本。",
      "x_vector_only_mode": false
    }
  },
  "training": {
    "batch_size": 4,
    "epochs": 200
  }
}
