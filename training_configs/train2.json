{
  "_comment": "第二个独立模型示例 / A second independent model example",
  "task": "train",
  "preset": "quality",
  "experiment": {
    "name": "model_2",
    "languages": ["en", "fr", "es", "pt"],
    "device": "cuda:1"
  },
  "dataset": {
    "sentences_per_language": 2000,
    "speakers": {
      "voice_02": "voice_02"
    },
    "text": {
      "provider": "builtin"
    },
    "voices": {
      "voice_02": {
        "mode": "design",
        "reference_strategy": "cascade",
        "regenerate_audio": false,
        "prompt": "A confident adult voice with crisp articulation and natural expressive pacing.",
        "reference_text": "This reference creates a consistent multilingual voice.",
        "reference_language": "en"
      }
    }
  },
  "training": {
    "batch_size": 4,
    "epochs": 200
  }
}
