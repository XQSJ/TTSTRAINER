{
  "_comment": "高质量训练基线；约 39M Generator，训练和显存成本显著高于默认紧凑预设 / Higher-quality training baseline; about 39M generator parameters with substantially higher training and memory cost",
  "_comment_duration_predictor": "质量档使用 6 层 Flow SDP；旧 checkpoint 在 resume 时仍自动使用原时长结构 / Quality uses a 6-layer flow SDP; resume automatically preserves a legacy checkpoint's duration architecture",
  "extends": "pipeline_defaults.json",
  "model": {
    "hidden_channels": 256,
    "latent_channels": 256,
    "conditioning_channels": 256,
    "language_embedding_channels": 64,
    "speaker_embedding_channels": 128,
    "text_encoder_layers": 8,
    "text_encoder_heads": 8,
    "flow_layers": 8,
    "duration_predictor_type": "stochastic_quality",
    "duration_predictor_channels": 128,
    "duration_predictor_flow_layers": 6,
    "decoder_initial_channels": 512,
    "decoder_resblock_kernel_sizes": [3, 7, 11]
  },
  "audio": {
    "mel_power": 1.0
  },
  "training": {
    "batch_size": 4,
    "learning_rate_generator": 0.0002,
    "learning_rate_discriminator": 0.0002,
    "epochs": 200,
    "checkpoint_every_steps": 10000,
    "checkpoint_every_epochs": 5,
    "log_every_steps": 50,
    "num_workers": 2,
    "seed": 1337,
    "text_prior_refinement": {
      "_comment": "至少训练 30000 step，且每个语言×音色连续 3 次通过分段与完整 Posterior 门槛后才冻结声学主链 / Freeze acoustics only after 30000 steps and three consecutive per-language×voice segment/full Posterior passes",
      "enabled": true,
      "start_steps": 30000,
      "posterior_mel_threshold": 0.45,
      "full_posterior_mel_threshold": 0.45,
      "require_all_profiles": true,
      "consecutive_passes": 3,
      "learning_rate": 0.0001,
      "lr_decay": 0.999875,
      "mel_weight": 1.0,
      "mel_warmup_steps": 5000,
      "kl_weight": 1.0,
      "duration_nll_weight": 1.0,
      "duration_mean_weight": 1.0
    }
  },
  "validation": {
    "every_epochs": 5,
    "metric": "combined_mel",
    "preview_every_epochs": 10
  }
}
